# ─── Bevi Base — environment variables ───────────────────────────────────────
#
# This is the template. You normally never touch it: `npm run dev` creates
# `.env.local` on the first start, pulling the real values from Vercel.
#
#   npm run env:pull     refresh the values from Vercel
#   npm run check:env    show what is still missing
#
# To fill it in by hand instead: `cp .env.example .env.local` and edit.
# `.env.local` is gitignored — never commit it.


# ─── Supabase (required) ──────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
# Without these, login and every page that reads the database will fail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, bypasses row level security. Used by the API routes that
# read/write bank statements and uploads. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Local development only ───────────────────────────────────────────────────
# Skips the Google login while running `npm run dev`, so /dashboard opens
# directly. The setup adds this line automatically on the first start. Ignored by
# any production build — see docs/LOCAL_DEV.md.
# DEV_AUTH_BYPASS=true


# ─── Shopify (optional — orders, sales, inventory, prices) ────────────────────
# Shopify Admin → Settings → Apps and sales channels → Develop apps
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
# Only needed for the OAuth install flow (/api/shopify/install)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=


# ─── Meta / Facebook Ads (optional — marketing pages) ─────────────────────────
# Meta Business Suite → Ads Manager. Account ID with or without the `act_` prefix.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=


# ─── WeShip (optional — shipping costs) ───────────────────────────────────────
# Base URL without trailing slash, e.g. https://portal.weship.at
WESHIP_BASE_URL=
WESHIP_USERNAME=
WESHIP_PASSWORD=


# ─── PayPal (optional — payment data) ─────────────────────────────────────────
# PayPal Developer Dashboard → My Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `live` (default) or `sandbox`
PAYPAL_ENV=live
